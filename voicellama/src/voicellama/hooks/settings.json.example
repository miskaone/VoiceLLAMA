{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /mnt/c/dev/VoiceLLAMA/voicellama/src/voicellama/hooks/tts_notify.py"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /mnt/c/dev/VoiceLLAMA/voicellama/src/voicellama/hooks/tts_tool_notify.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /mnt/c/dev/VoiceLLAMA/voicellama/src/voicellama/hooks/context_tracker.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /mnt/c/dev/VoiceLLAMA/voicellama/src/voicellama/hooks/tts_stop_notify.py"
          }
        ]
      }
    ]
  }
}
